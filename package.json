{
  "name": "writing-room",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "server:build": "vite build --config server/vite.config.ts",
    "server": "npm run server:build && node dist-server/main.js",
    "dev:server": "node scripts/watch-api.mjs",
    "build": "npm run typecheck && vite build",
    "postbuild": "node scripts/copy-builtin-extensions.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.browser.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.extension-worker.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/nanum-gothic": "5.3.0",
    "@fontsource/nanum-myeongjo": "5.3.0",
    "@fontsource/noto-sans-kr": "5.3.1",
    "@fontsource/noto-serif-kr": "5.3.1",
    "@mdit/plugin-footnote": "0.23.2",
    "@mdit/plugin-tasklist": "0.23.2",
    "@vscode/codicons": "0.0.46-24",
    "markdown-it": "14.3.3",
    "monaco-editor": "0.57.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.2",
    "prosemirror-inputrules": "1.7.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.4",
    "prosemirror-model": "1.25.13",
    "prosemirror-schema-list": "1.6.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-view": "1.43.0",
    "vscode-oniguruma": "1.7.0",
    "vscode-textmate": "9.3.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.18"
    }
  }
}
