{
  "name": "configuration-api",
  "publisher": "writing-room-tests",
  "version": "1.0.0",
  "displayName": "Configuration API Fixture",
  "browser": "./browser/extension",
  "contributes": {
    "configuration": {
      "title": "Configuration API Fixture",
      "properties": {
        "configurationApi.greeting": { "type": "string", "default": "hello", "description": "A greeting." },
        "configurationApi.count": { "type": "integer", "default": 1, "minimum": 0, "description": "A count." }
      }
    },
    "configurationDefaults": {
      "[markdown]": { "configurationApi.greeting": "markdown hello" }
    },
    "commands": [
      { "command": "configurationApi.report", "title": "Report Fixture Configuration" },
      { "command": "configurationApi.update", "title": "Update Fixture Configuration" },
      { "command": "configurationApi.updateWorkspace", "title": "Update Fixture Workspace Configuration" }
    ]
  }
}
