{
  "name": "memfs",
  "publisher": "fixture",
  "version": "1.0.0",
  "engines": { "vscode": "*" },
  "browser": "./extension.js",
  "activationEvents": [
    "onFileSystem:memfs", "onFileSystem:memfs-readonly",
    "onCommand:fixture.memfs.openReadOnlyMarkdown", "onCommand:fixture.memfs.openReadOnlyTypewriter"
  ],
  "contributes": {
    "commands": [
      { "command": "fixture.memfs.openReadOnlyMarkdown", "title": "Open Read-only Markdown Fixture" },
      { "command": "fixture.memfs.openReadOnlyTypewriter", "title": "Open Read-only Typewriter Fixture" },
      { "command": "fixture.memfs.openReadOnlyRule", "title": "Open Read-only Rule Fixture" }
    ]
  }
}
