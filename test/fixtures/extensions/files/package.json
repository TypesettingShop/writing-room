{
  "name": "files-dialogs",
  "publisher": "writing-room-tests",
  "version": "1.0.0",
  "displayName": "Files Dialog Fixture",
  "browser": "./browser/extension",
  "contributes": {
    "commands": [
      {
        "command": "filesFixture.openMany",
        "title": "Files Fixture: Open Many"
      },
      {
        "command": "filesFixture.saveOutside",
        "title": "Files Fixture: Save Starting Outside"
      },
      {
        "command": "filesFixture.markdownItem",
        "title": "Fixture Markdown Action"
      },
      {
        "command": "filesFixture.folderItem",
        "title": "Fixture Folder Action"
      },
      {
        "command": "filesFixture.revealDeep",
        "title": "Files Fixture: Reveal Deep Note"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "filesFixture.markdownItem",
          "when": "resourceExtname == .md",
          "group": "fixture"
        },
        {
          "command": "filesFixture.folderItem",
          "when": "explorerResourceIsFolder",
          "group": "fixture"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "filesFixture.view",
          "name": "Files Fixture View"
        }
      ]
    }
  }
}
