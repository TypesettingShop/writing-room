{
  "name": "documents",
  "publisher": "fixtures",
  "displayName": "Documents Fixture",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.0.0"
  },
  "browser": "./extension.js",
  "activationEvents": [
    "onCommand:documents.check",
    "onCommand:documents.checkEditor",
    "onCommand:documents.checkBulk",
    "onCommand:documents.clearDecoration"
  ],
  "contributes": {
    "commands": [
      {
        "command": "documents.check",
        "title": "Check Document API"
      },
      {
        "command": "documents.checkEditor",
        "title": "Check Text Editor API"
      },
      {
        "command": "documents.checkBulk",
        "title": "Check Workspace Edit API"
      },
      {
        "command": "documents.clearDecoration",
        "title": "Clear Fixture Decoration"
      }
    ]
  }
}
